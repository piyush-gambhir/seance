# ─────────────────────────────────────────────────────────────────────────────
# SÉANCE — environment configuration
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# ── D-ID ─────────────────────────────────────────────────────────────────────
# Your D-ID API key (the long "Basic" key from https://studio.d-id.com → API).
# Server-side ONLY. Used by `npm run setup:agent` to create the avatar agent and
# to mint/serve the domain-scoped client key. Never shipped to the browser.
DID_API_KEY=

# After running `npm run setup:agent`, paste the two values it prints here.
# The agent id is safe in the client; the client key is domain-scoped (also safe,
# but we serve it via /api/did-credentials to keep it out of the static bundle).
DID_AGENT_ID=
DID_CLIENT_KEY=

# ── ElevenLabs (the "brain": STT + LLM + TTS, bound into the D-ID agent) ──────
# Your ElevenLabs API key. Server-side ONLY. The setup script stores it in D-ID's
# secret vault so D-ID can talk to your ElevenLabs agent on your behalf.
ELEVENLABS_API_KEY=

# The ElevenLabs *Agent* id for "Madame Esmé Voss" (create it in the ElevenLabs
# dashboard → Agents; see docs/ESME_ELEVENLABS_CONFIG.md). Format: agent_xxx
ELEVENLABS_AGENT_ID=

# ── Avatar presenter (the face) ──────────────────────────────────────────────
# A D-ID V4 "expressive" presenter id. Default is a public one; swap for a custom
# Victorian-medium presenter you create in D-ID Studio for a stronger character.
DID_PRESENTER_ID=public_mia_elegant@avt_TJ0Tq5

# ── Vision enrichment (OPTIONAL) ─────────────────────────────────────────────
# D-ID's built-in vision already lets Esmé "see" the camera. These keys only power
# OPTIONAL extras: a structured object inspector and a nicer prophecy share-card.
# The app runs fine without them. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
VISION_PROVIDER=gemini

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
